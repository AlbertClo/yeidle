{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "preserve",
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/renderer/src/*"
            ]
        },
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/preload/*.d.ts"
    ]
}
