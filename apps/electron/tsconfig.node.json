{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "electron.vite.config.ts",
        "playwright.config.ts",
        "e2e/**/*",
        "src/main/**/*",
        "src/preload/**/*"
    ]
}
