{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "jsx": "preserve",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "types": ["vite/client"],
        "paths": {
            "@/*": ["../electron/src/renderer/src/*"],
            "node:crypto": ["./src/shims/nodeCrypto.ts"]
        }
    },
    "include": [
        "src/**/*.ts",
        "../electron/src/renderer/src/types/global.d.ts",
        "../electron/src/preload/*.d.ts"
    ]
}
